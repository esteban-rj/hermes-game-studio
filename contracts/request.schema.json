{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-game-studio/request-v1",
  "title": "Petición UX del estudio v1",
  "type": "object",
  "required": ["id", "projectId", "description", "acceptanceCriteria", "status", "stageIndex", "taskIds", "evidence", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "enum": ["studio", "juego-a", "juego-b"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "status": { "enum": ["active", "done"] },
    "stageIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
    "taskIds": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
